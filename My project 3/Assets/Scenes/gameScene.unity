--- !u!114 &1179551624
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1179551621}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e87b5948cda2ff34c9d43a4d7add54bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialPanel: {fileID: 1179551621}
  dungeonSelectPanel: {fileID: 642767964}
  hudRoot: {fileID: 1980792087}
  turnInputRoot: {fileID: 1505766869}
  resultPanel: {fileID: 1601808295}
  debugRoot: {fileID: 2099880933}
  turnUIVisibility: {fileID: 524864950}
  titleText: {fileID: 2062927650}
  bodyText: {fileID: 176603173}
  stepText: {fileID: 514293134}
  tutorialImage: {fileID: 1604028996}
  tutorialVideoImage: {fileID: 1802976569}
  videoPlayer: {fileID: 1179551623}
  nextButton: {fileID: 1829452395}
  backButton: {fileID: 1147800562}
  skipButton: {fileID: 2090580113}
  pages:
  - title: Welcome!
    body: "\r\n\u30C0\u30F3\u30B8\u30E7\u30F3\u3092\u653B\u7565\u3057\u3066\u3001\u6551\u51FA\u5BFE\u8C61\u3092\u52A9\u3051\u306A\u304C\u3089\u6700\u7D42\u30B9\u30C6\u30FC\u30B8\u306E\u30DC\u30B9\u6483\u7834\u3092\u76EE\u6307\u305D\u3046\u3002\r\n\u307E\u305A\u306F\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3067\u57FA\u672C\u64CD\u4F5C\u3092\u78BA\u8A8D\u3057\u307E\u3059\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  - title: Dungeon Select
    body: "\r\n\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u5F8C\u306B\u96E3\u6613\u5EA6\u3092\u9078\u629E\u3057\u307E\u3059\u3002\r\nBeginner
      / Easy / Normal / Hard \u304B\u3089\u597D\u304D\u306A\u30C0\u30F3\u30B8\u30E7\u30F3\u3092\u9078\u3093\u3067\u958B\u59CB\u3057\u307E\u3057\u3087\u3046\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  - title: ' Aim '
    body: "\r\n\u753B\u9762\u3092\u30C9\u30E9\u30C3\u30B0\u3059\u308B\u3068\u3001\u30DC\u30FC\u30EB\u306E\u73FE\u5728\u4F4D\u7F6E\u304B\u3089\u72D9\u3046\u65B9\u5411\u3092\u6C7A\u3081\u3089\u308C\u307E\u3059\u3002\r\n\u30C9\u30E9\u30C3\u30B0\u65B9\u5411\u3067\u6A2A\u65B9\u5411360\u5EA6\u306B\u72D9\u3048\u307E\u3059\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  - title: Power
    body: "\r\n\u30C9\u30E9\u30C3\u30B0\u3059\u308B\u8DDD\u96E2\u304C\u9577\u3044\u307B\u3069\u30B7\u30E7\u30C3\u30C8\u306E\u5A01\u529B\u304C\u4E0A\u304C\u308A\u307E\u3059\u3002\r\n\u77E2\u5370\u306E\u9577\u3055\u3068\u8272\u3067\u30D1\u30EF\u30FC\u3092\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  - title: Pitch
    body: "\r\nAim\u3092\u6C7A\u3081\u305F\u5F8C\u3001\u5DE6\u4E0B\u306EPitchSlider\u3067\u4E0A\u4E0B\u306E\u89D2\u5EA6\u3092\u8ABF\u6574\u3067\u304D\u307E\u3059\u3002\r\n\u4E0A\u5411\u304D\u30FB\u6C34\u5E73\u30FB\u4E0B\u5411\u304D\u306E\u30B7\u30E7\u30C3\u30C8\u3092\u4F7F\u3044\u5206\u3051\u307E\u3057\u3087\u3046\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  - title: Camera
    body: "\r\nOverview\u30DC\u30BF\u30F3\u3067\u3075\u304B\u3093\u8996\u70B9\u306B\u5207\u308A\u66FF\u3048\u3089\u308C\u307E\u3059\u3002\r\n\u30B9\u30DE\u30DB\u3067\u306F2\u672C\u6307\u30C9\u30E9\u30C3\u30B0\u3067\u5468\u56F2\u3092\u898B\u56DE\u3057\u30012\u672C\u6307\u30D4\u30F3\u30C1\u3067\u62E1\u5927\u7E2E\u5C0F\u3067\u304D\u307E\u3059\u3002\r\nPlayer\u30DC\u30BF\u30F3\u3067\u30DC\u30FC\u30EB\u3092\u8FFD\u3046\u8996\u70B9\u306B\u623B\u305B\u307E\u3059\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  - title: Breakable Blocks
    body: "\r\n\u8D64\u3084\u30AA\u30EC\u30F3\u30B8\u8272\u306E\u30D6\u30ED\u30C3\u30AF\u306F\u58CA\u305B\u308B\u30D6\u30ED\u30C3\u30AF\u3067\u3059\u3002\r\n\u30DC\u30FC\u30EB\u3092\u5F53\u3066\u305F\u308AMine\u7206\u767A\u3092\u4F7F\u3046\u3053\u3068\u3067\u7834\u58CA\u3067\u304D\u307E\u3059\u3002\r\n\u7070\u8272\u306E\u30D6\u30ED\u30C3\u30AF\u306F\u58CA\u305B\u306A\u3044\u306E\u3067\u3001\u53CD\u5C04\u306B\u5229\u7528\u3057\u307E\u3057\u3087\u3046\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  - title: Mine
    body: "\r\nMine\u3092\u6301\u3063\u3066\u3044\u308B\u72B6\u614B\u3067\u30DC\u30FC\u30EB\u304C\u4F55\u304B\u306B\u885D\u7A81\u3059\u308B\u3068\u3001Mine\u30921\u3064\u6D88\u8CBB\u3057\u3066\u7206\u767A\u3057\u307E\u3059\u3002\r\n\u7206\u767A\u306F\u58CA\u305B\u308B\u30D6\u30ED\u30C3\u30AF\u3084\u6551\u51FA\u5BFE\u8C61\u306B\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  - title: Rescue
    body: "\r\n\u6551\u51FA\u5BFE\u8C61\u3092\u52A9\u3051\u308B\u3068Allies\u304C\u5897\u3048\u307E\u3059\u3002\r\n\u6551\u51FA\u3057\u305F\u4EBA\u6570\u306B\u5FDC\u3058\u3066\u3001\u6B21\u30B9\u30C6\u30FC\u30B8\u958B\u59CB\u6642\u306EMine\u6570\u304C\u5897\u3048\u307E\u3059\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  - title: Boss Stage
    body: "\r\n10\u30B9\u30C6\u30FC\u30B8\u76EE\u306F\u30DC\u30B9\u30B9\u30C6\u30FC\u30B8\u3067\u3059\u3002\r\n\u5F31\u70B9\u3092\u72D9\u3063\u3066\u30DC\u30B9\u3092\u5012\u3059\u3068\u30C0\u30F3\u30B8\u30E7\u30F3\u30AF\u30EA\u30A2\u3067\u3059\u3002\r\n\u6E96\u5099\u304C\u3067\u304D\u305F\u3089Start\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044\u3002\r\n"
    image: {fileID: 0}
    videoClip: {fileID: 0}
    useVideo: 0
  showOnStart: 1
  rememberCompleted: 0
